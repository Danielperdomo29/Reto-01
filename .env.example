# Proveedor LLM: "gemini" o "openai"
LLM_PROVIDER=gemini
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-2.5-flash

# Alternativa OpenAI (si cambias LMM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Límites de seguridad y costos (Sección 8 del PRD)
PORT=3000
MAX_ITERATIONS_PER_TURN=25
MAX_TOKENS_PER_SESSION=50000
# Fecha de referencia opcional (YYYY-MM-DDi; por defecto 2026-09-03 para evaluación determinista
REFERENCE_DATE=2026-09-03
