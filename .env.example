# Proveedor LLM: "openrouter", "gemini" o "openai"
LLM_PROVIDER=openrouter

# OpenRouter (Modelo gratuito verificado y de alta disponibilidad con Function Calling)
OPENROUTER_API_KEY=tu_api_key_aqui
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Google Gemini (Alternativa de baja latencia)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (Alternativa)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Límites de seguridad, timeouts y costos (Sección 8 del PRD)
PORT=3000
LLM_TIMEOUT_MS=90000
MAX_ITERATIONS_PER_TURN=25
MAX_TOKENS_PER_SESSION=60000
MAX_GLOBAL_TOKENS=500000
REFERENCE_DATE=2026-09-03
