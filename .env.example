# Proveedor LLM: "openrouter", "gemini" o "openai"
LLM_PROVIDER=openrouter

# OpenRouter (Modelos recomendados: meta-llama/llama-3.3-70b-instruct:free, nvidia/llama-3.1-nemotron-70b-instruct:free, qwen/qwen-2.5-72b-instruct)
OPENROUTER_API_KEY=tu_api_key_aqui
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Google Gemini (Alternativa)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (Alternativa)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Límites de seguridad y costos (Sección 8 del PRD)
PORT=3000
MAX_ITERATIONS_PER_TURN=25
MAX_TOKENS_PER_SESSION=50000
REFERENCE_DATE=2026-09-03
